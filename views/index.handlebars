<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{title}}</title>
    <base href="{{baseHref}}" />
    <link rel="stylesheet" href="{{elements-css}}">
    
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="{{baseHref}}favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{baseHref}}favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{baseHref}}favicon/favicon-16x16.png">
    <link rel="manifest" href="{{baseHref}}favicon/site.webmanifest">
    <link rel="mask-icon" href="{{baseHref}}favicon/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    
    <style>
      :root {
        --background-color: #ffffff;
        --text-color: #333333;
      }
      [data-theme="dark"] {
        --background-color: #1e1e1e;
        --text-color: #ffffff;
      }
      body {
        background-color: var(--background-color);
        color: var(--text-color);
      }
      #theme-toggle-container {
        position: fixed;
        bottom: 20px;
        left: 20px;
        z-index: 1000;
      }
      .theme-switch {
        display: inline-block;
      }
      .theme-switch .theme-toggle {
        display: none;
      }
      .theme-switch .theme-toggle + label {
        cursor: pointer;
        display: inline-block;
        position: relative;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 1px solid #d5ddeb;
        box-shadow: 0 2px 10px rgba(9, 12, 17, 0.25);
        background-size: 22px 22px;
        background-repeat: no-repeat;
        background-position: center;
        transition: all 0.3s ease-in-out;
      }
      [data-theme="dark"] .theme-switch .theme-toggle + label {
        background-color: #1a212d;
        border-color: #262f40;
      }
      .theme-switch .theme-toggle + label {
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23333333"><path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"/></svg>');
      }
      .theme-switch .theme-toggle:checked + label {
        background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23FFFFFF"><path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"/></svg>');
      }
      .sl-px-4 {
        display: none;
      }
      .sl-code-viewer__scroller {
        max-height: 250px !important;
      }
      .sl-invisible {
        visibility: visible;
      }
      .sl-px-1\.5 {
        padding-left: 10px;
        padding-right: 10px;
      }
      .sl-pr-2 {
        padding-right: 0px;
        margin-right: 25px;
      }
      .sl-elements .OperationParametersContent {
          max-height: max-content;
      }
      [data-theme="dark"] .token {
        color: #e6e6e6 !important;
      }
      [data-theme="dark"] .token.string {
        color: #7ec699 !important;
      }
      [data-theme="dark"] .token.number {
        color: #f08d49 !important;
      }
      [data-theme="dark"] .token.boolean {
        color: #f08d49 !important;
      }
      [data-theme="dark"] .token.keyword {
        color: #cc99cd !important;
      }
      [data-theme="dark"] .token.operator {
        color: #67cdcc !important;
      }
      [data-theme="dark"] .token.punctuation {
        color: #999 !important;
      }

      /* הסתרת הלוגו של Stoplight */
      elements-api::part(powered-by-stoplight) {
        display: none !important;
      }
      elements-api a[href^="https://stoplight.io/?utm_source=elements"] {
        display: none !important;
      }

      /* Mobile navigation drawer: the hamburger button and the dimming
         backdrop. Both are hidden until the mobile breakpoint below. */
      #nav-toggle {
        display: none;
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 1003;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 8px;
        border: 1px solid #d5ddeb;
        background-color: #ffffff;
        color: #333333;
        box-shadow: 0 2px 10px rgba(9, 12, 17, 0.25);
        cursor: pointer;
      }
      [data-theme="dark"] #nav-toggle {
        background-color: #1a212d;
        border-color: #262f40;
        color: #ffffff;
      }
      #nav-toggle svg {
        width: 22px;
        height: 22px;
      }
      #nav-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1001;
        background-color: rgba(9, 12, 17, 0.5);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
    </style>
    <script>
      // Decide the theme before anything renders to avoid a flash of the
      // wrong theme and to keep the page and Elements in the same palette
      (function () {
        var saved = localStorage.getItem('theme');
        var dark = saved
          ? saved === 'dark'
          : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    <style>

      @media (max-width: 768px) {
        #nav-toggle {
          display: flex;
        }

        /* Turn the Elements sidebar (which lists every operation) into a
           slide-in drawer instead of hiding it behind a stacked layout */
        .sl-elements-api > div:first-child {
          position: fixed;
          top: 0;
          left: -340px;
          height: 100%;
          max-width: 85vw;
          z-index: 1002;
          transition: left 0.25s ease;
        }
        body.nav-open .sl-elements-api > div:first-child {
          left: 0;
          box-shadow: 2px 0 16px rgba(9, 12, 17, 0.35);
        }
        body.nav-open #nav-backdrop {
          opacity: 1;
          pointer-events: auto;
        }

        /* The content column fills the width once the sidebar is out of
           flow; leave room at the top for the hamburger button */
        .sl-elements-api > div:nth-child(2) {
          padding-top: 56px;
        }

        #theme-toggle-container {
          bottom: 12px;
          left: 12px;
        }
        .theme-switch .theme-toggle + label {
          width: 40px;
          height: 40px;
          background-size: 20px 20px;
        }
        .sl-elements h1.sl-text-5xl {
          font-size: 28px;
        }
        .sl-code-viewer__scroller {
          max-height: 200px !important;
        }
      }
    </style>
  </head>
  <body style="display: flex; flex-direction: column; height: 100vh;">
    <elements-api
      id="elements-api"
      basePath="{{elements.basePath}}"
      hideInternal="{{elements.hideInternal}}"
      hideTryIt="{{elements.hideTryIt}}"
      tryItCorsProxy="{{elements.tryItCorsProxy}}"
      tryItCredentialsPolicy="{{elements.tryItCredentialsPolicy}}"
      layout="{{elements.layout}}"
      logo="{{elements.logo}}"
      router="{{elements.router}}"
      style="{{elements.style}}"
    ></elements-api>
    <button id="nav-toggle" type="button" aria-label="Toggle navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div id="nav-backdrop"></div>
    <div id="theme-toggle-container">
      <div class="theme-switch">
        <input type="checkbox" id="theme-toggle" class="theme-toggle">
        <label for="theme-toggle"></label>
      </div>
    </div>
    <script src="{{elements-js}}"></script>
    <script>
      document.addEventListener('DOMContentLoaded', async () => {
        const docs = document.getElementById('elements-api');
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;

        function setTheme(isDark) {
          html.setAttribute('data-theme', isDark ? 'dark' : 'light');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          themeToggle.checked = isDark;
          docs.setAttribute('theme', isDark ? 'dark' : 'light');
        }

        themeToggle.addEventListener('change', () => {
          setTheme(themeToggle.checked);
        });

        // The theme itself was already decided by the inline script in <head>;
        // here we only align the toggle and the Elements component with it
        const isDark = html.getAttribute('data-theme') === 'dark';
        themeToggle.checked = isDark;
        docs.setAttribute('theme', isDark ? 'dark' : 'light');

        // Listen for changes in system color scheme
        window.matchMedia('(prefers-color-scheme: dark)').addListener((e) => {
          if (!localStorage.getItem('theme')) {
            setTheme(e.matches);
          }
        });

        // On narrow screens the full sidebar (which lists every operation)
        // becomes a slide-in drawer, driven by the hamburger button. The CSS
        // handles the visuals; here we only toggle the body class and make
        // sure the drawer closes after navigating or when leaving mobile.
        const mobileQuery = window.matchMedia('(max-width: 768px)');
        const navToggle = document.getElementById('nav-toggle');
        const navBackdrop = document.getElementById('nav-backdrop');

        function closeNav() {
          document.body.classList.remove('nav-open');
        }

        navToggle.addEventListener('click', () => {
          document.body.classList.toggle('nav-open');
        });
        navBackdrop.addEventListener('click', closeNav);

        document.addEventListener('click', (event) => {
          if (!mobileQuery.matches) return;
          const link = event.target.closest('a');
          if (link && link.closest('.sl-elements-api')) {
            closeNav();
          }
        });

        mobileQuery.addListener((event) => {
          if (!event.matches) closeNav();
        });

        try {
          let text = await fetch('{{elements.apiDescriptionUrl}}').then(res => res.text())
          {{#each variables}}
          text = text.replaceAll('{{../delimiters.open}}{{@key}}{{../delimiters.close}}', '{{this}}')
          {{/each}}
          console.info('Successfully fetched API docs and replaced variables')
          docs.apiDescriptionDocument = text
        } catch(err) {
          console.info('Failed to fetch API docs, trying to render it from URL')
          docs.apiDescriptionUrl = '{{elements.apiDescriptionUrl}}'
        }
      })
    </script>
    {{#if watch}}
    <script>
      (function() {
        var protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        var basePath = '{{baseHref}}'.replace(/^\/|\/$/g, ''); // מסיר את ה-'/' מתחילת וסוף ה-baseHref
        var wsPath = basePath ? '/' + basePath : '';
        var socket = new WebSocket(protocol + '//' + window.location.host + wsPath);
        socket.onmessage = function(event) {
          var data = JSON.parse(event.data);
          if (data.type === 'reload') {
            window.location.reload();
          }
        };
      })();
    </script>
    {{/if}}
  </body>
</html>